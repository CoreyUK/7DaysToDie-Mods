<?xml version="1.0" encoding="UTF-8"?>
<!--
    THE EIGHTH DAY - blocks.xml
    ===========================
    The Long Craft's workstations.

    Vanilla's production chain is two steps deep: ore in the forge, item out of the
    workbench. This file makes industry something you BUILD, with real intermediates
    that have their own supply problems.

        ore ===> Bloomery ===> crude iron ===+
                                             +==> Forge ===> stock metal
        scrap ===============================+                     |
                                                                   v
        coal + flux ===> Blast Furnace ===> steel ===> hardened ===> carbide
                                                                   |
        Machine Shop <=== precision parts <========================+
             |
             v
        Drafting Table ===> consumes Field Notes ===> recipes the perk tree cannot give

    ART NOTE: every workstation extends a vanilla block and reuses its crafting window,
    and every one of the six has its own model and icon (Resources/src/, built by
    tools/gen_models.py). The models are waiting on the Unity bundle step - each
    block's Meshfile line is commented out below until eighthday.unity3d exists.

    VERIFY-4 (docs/VERIFICATION.md): confirm the workstation window names below still
    exist. V3.0 split XUi into XUi_Common / XUi_InGame / XUi_Menu and renamed
    controls.xml to templates.xml, so anything UI-adjacent is higher-risk than usual.
-->
<configs>

    <append xpath="/blocks">

        <!-- ==================================================================
             BLOOMERY - tier 0.5
             Cheap, early, iron only. Exists so the metal chain starts on day 2
             with a clay-and-stone build instead of waiting on a forge.
             Output is crude iron: deliberately worse than vanilla forged iron,
             so building the real forge still matters.
             ================================================================== -->
        <block name="edBlockBloomery">
            <property name="Extends" value="forge" />
            <property name="CreativeMode" value="Player" />
            <!-- Icon comes from UIAtlases/ItemIconAtlas/edBlockBloomery.png, rendered from
                 this block's own model by tools/gen_models.py - no CustomIcon needed.

                 MESH: the custom model exists (Resources/src/edBlockBloomery/) but has not
                 yet been through Unity. Once eighthday.unity3d is built and copied
                 into Resources/, uncomment the line below - VERIFY-18.
            <property name="Meshfile" value="#@modfolder:Resources/eighthday.unity3d?edBlockBloomery" />
            -->
            <property name="DescriptionKey" value="edBlockBloomeryDesc" />
            <property name="CraftingAreaRecipes" value="edBloomery" />
            <property name="EconomicValue" value="300" />
            <property class="RepairItems">
                <property name="resourceStone" value="30" />
                <property name="resourceClayLump" value="20" />
            </property>
        </block>

        <!-- ==================================================================
             BLAST FURNACE - tier 2
             Steel, hardened steel and carbide. Consumes flux, which is the whole
             reason limestone and bone have a purpose past day 10.
             Ironmonger-gated by recipe, not by block - anyone can build one,
             only an Ironmonger can use it for anything worthwhile.
             ================================================================== -->
        <block name="edBlockBlastFurnace">
            <property name="Extends" value="forge" />
            <property name="CreativeMode" value="Player" />
            <!-- Icon comes from UIAtlases/ItemIconAtlas/edBlockBlastFurnace.png, rendered from
                 this block's own model by tools/gen_models.py - no CustomIcon needed.

                 MESH: the custom model exists (Resources/src/edBlockBlastFurnace/) but has not
                 yet been through Unity. Once eighthday.unity3d is built and copied
                 into Resources/, uncomment the line below - VERIFY-18.
            <property name="Meshfile" value="#@modfolder:Resources/eighthday.unity3d?edBlockBlastFurnace" />
            -->
            <property name="DescriptionKey" value="edBlockBlastFurnaceDesc" />
            <property name="CraftingAreaRecipes" value="edBlastFurnace" />
            <property name="EconomicValue" value="4500" />
            <property class="RepairItems">
                <property name="resourceForgedIron" value="60" />
                <property name="resourceCement" value="80" />
            </property>
        </block>

        <!-- ==================================================================
             MACHINE SHOP - tier 2
             Turns stock metal into precision parts. Every powered device in the
             mod wants them, which makes this the block that gates the electrical
             and vehicle tiers behind the metal tier.
             ================================================================== -->
        <block name="edBlockMachineShop">
            <property name="Extends" value="workbench" />
            <property name="CreativeMode" value="Player" />
            <!-- Icon comes from UIAtlases/ItemIconAtlas/edBlockMachineShop.png, rendered from
                 this block's own model by tools/gen_models.py - no CustomIcon needed.

                 MESH: the custom model exists (Resources/src/edBlockMachineShop/) but has not
                 yet been through Unity. Once eighthday.unity3d is built and copied
                 into Resources/, uncomment the line below - VERIFY-18.
            <property name="Meshfile" value="#@modfolder:Resources/eighthday.unity3d?edBlockMachineShop" />
            -->
            <property name="DescriptionKey" value="edBlockMachineShopDesc" />
            <property name="CraftingAreaRecipes" value="edMachineShop" />
            <property name="EconomicValue" value="5200" />
            <property class="RepairItems">
                <property name="resourceForgedSteel" value="40" />
                <property name="resourceMechanicalParts" value="25" />
            </property>
        </block>

        <!-- ==================================================================
             REAGENT BENCH - tier 1.5
             The Apothecary's workspace. Everything medical starts here, including
             the tiered infection cures that make the Calling a group lifeline.
             ================================================================== -->
        <block name="edBlockReagentBench">
            <property name="Extends" value="chemistryStation" />
            <property name="CreativeMode" value="Player" />
            <!-- Icon comes from UIAtlases/ItemIconAtlas/edBlockReagentBench.png, rendered from
