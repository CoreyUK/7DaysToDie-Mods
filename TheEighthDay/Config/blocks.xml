            <property name="CustomIcon" value="terrOreIron" />
            <property name="DescriptionKey" value="edOreBitumenDesc" />
            <property name="MaxDamage" value="900" />
            <property name="EconomicValue" value="18" />
            <drop event="Harvest" name="edResourceBitumen" count="2,4"
                  tool_category="Mining" />
            <drop event="Destroy" count="0" />
