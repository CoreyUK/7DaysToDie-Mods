              description_key="edBuffTurning1Desc" icon="ui_game_symbol_campfire"
              icon_color="220,140,80" remove_on_death="true">
            <stack_type value="ignore" />
            <duration value="20" />

            <!-- Second contact is not a second Turning. Drop on sight if this Cycle
                 has already been announced, so the message keeps its weight. -->
            <effect_group name="edTurning1Repeat">
                <requirement name="CVarCompare" cvar="edSeenCycle1" operation="Equals" value="1" />
                <triggered_effect trigger="onSelfBuffStart" action="RemoveBuff"
                                  buff="edBuffTurning1" />
            </effect_group>

            <effect_group name="edTurning1First">
                <requirement name="CVarCompare" cvar="edSeenCycle1" operation="NotEquals" value="1" />
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar"
                                  cvar="edSeenCycle1" operation="set" value="1" />
            </effect_group>

            <!-- A Turning is one-way, so the cycle read only ever climbs. Meeting a
                 Husk after a Bloater does not walk the world back to Cycle 1. -->
            <effect_group name="edTurning1Raise">
                <requirement name="CVarCompare" cvar="edCycle" operation="LT" value="1" />
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar"
