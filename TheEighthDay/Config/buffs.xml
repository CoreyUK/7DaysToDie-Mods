    <!-- ==========================================================================
         5. INFECTION ENTRY POINT

         Without this the whole Attrition pillar is inert: the four stages exist
         but nothing ever starts them.

         Vanilla runs its own single-stage infection buff. Rather than fight it,
         this hands off: when vanilla infection lands, stage 1 of ours starts and
         vanilla's is cleared, so there is exactly one infection system in play
         and every existing source of infection in the game feeds it.

         THE CURE GUARD (edInfCured)
         ===========================
         Each stage advances on onSelfBuffFinish. A cure removes the buff, and if
         removal also counts as "finishing" it, curing stage 3 would immediately
         apply stage 4 - the exact opposite of what the player paid for. So every
         advance is gated on edInfCured, medicines set it to 1, and a fresh stage 1
         resets it to 0. Correct whichever way the engine treats RemoveBuff.

         VERIFY-13 (docs/VERIFICATION.md): confirm the vanilla infection buff is
         still named "buffInfection" in V3.2. If it was renamed, retarget the patch
         below - it is the only place this mod depends on that name.
         ========================================================================== -->

    <!-- ==========================================================================
         6. ATTRITION - durability

         The pillar says gear should be consumable on a long enough timeline, so
         that the production chain still matters at Cycle 6 instead of being
         something you finished at Cycle 2.

         WHAT THIS IS NOT
         ================
         The design originally called for repairs that restore less EACH TIME -
         diminishing returns per repair on a given item. That needs per-item
         state (how many times has this particular axe been repaired), and XML
         has nowhere to keep it. It is a C# module or it is nothing, so it is
         not pretended at here.

         What ships instead is a flat repair penalty: every repair returns less
         than vanilla, so gear drifts toward replacement rather than living
         forever on one repair kit. Same pressure, one dimension simpler, and
         honest about which one it is.

         Applied to players alongside the cycle tracker - see entityclasses.xml.
         ========================================================================== -->

    <append xpath="/buffs">

        <buff name="edBuffAttrition" hidden="true" remove_on_death="false"
              icon="ui_game_symbol_wrench">
            <stack_type value="ignore" />
            <duration value="0" />
            <effect_group name="edAttritionDurability">
                <passive_effect name="RepairAmount" operation="perc_add" value="-0.35" />
            </effect_group>
        </buff>

    </append>


    <append xpath="/buffs/buff[@name='buffInfection']">
        <effect_group name="edInfectionHandoff">
            <triggered_effect trigger="onSelfBuffStart" action="AddBuff"
                              buff="edBuffInfection1" />
            <triggered_effect trigger="onSelfBuffStart" action="RemoveBuff"
                              buff="buffInfection" />
        </effect_group>
    </append>


    <!-- ==========================================================================
         7. FOOD EFFECTS

         edBuffHerbalRelief deliberately does NOT cure infection. It masks the
         stamina drain for a while so an infected player can still work, and then
         it wears off and they are still infected. Curing is the Apothecary's
         pillar and a pot of soup must not undercut it.
         ========================================================================== -->

    <append xpath="/buffs">

        <buff name="edBuffWellFed" name_key="edBuffWellFedName"
              description_key="edBuffWellFedDesc" icon="ui_game_symbol_meat"
              icon_color="200,180,110">
            <stack_type value="replace" />
            <duration value="1800" />
            <effect_group name="edWellFedEffects">
                <passive_effect name="MaxStamina" operation="perc_add" value="0.15" />
                <passive_effect name="StaminaChangeOT" operation="base_add" value="0.6" />
                <passive_effect name="HealthChangeOT" operation="base_add" value="0.4" />
            </effect_group>
        </buff>

        <buff name="edBuffHerbalRelief" name_key="edBuffHerbalReliefName"
              description_key="edBuffHerbalReliefDesc" icon="ui_game_symbol_medical"
              icon_color="140,190,120">
            <stack_type value="replace" />
            <duration value="600" />
            <effect_group name="edHerbalReliefEffects">
                <passive_effect name="StaminaChangeOT" operation="base_add" value="1.2" />
                <passive_effect name="StaminaLoss" operation="perc_add" value="-0.2" />
            </effect_group>
        </buff>

    </append>

</configs>
