<?xml version="1.0" encoding="UTF-8"?>
<!--
    THE EIGHTH DAY - entitygroups.xml
    =================================
    One spawn pool per Cycle. These are the pools gamestages.xml maps the Cycle bands onto.

    A Turning is PERMANENT and ONE-WAY. Pool N contains everything from pools 1..N, so
    once an archetype enters the world it never leaves it - that property is the entire
    mechanic and must survive any retuning.

    VERIFY-2 (docs/VERIFICATION.md): V3.0 converted entity groups back to standard XML
    elements and V3.2 edited this file again. Confirm the child element and attribute
    names below, and confirm every vanilla group name this file appends to still exists.
-->
<configs>

    <!-- ==========================================================================
         THE CYCLE POOLS
         ========================================================================== -->

    <append xpath="/entitygroups">

        <!-- CYCLE 1 - the first "oh". Speed you were not planning for. -->
        <entitygroup name="edCycle1Pool">
            <entity name="edZombieHusk" prob="1.0" />
        </entitygroup>

        <!-- CYCLE 2 - melee stops being free. -->
        <entitygroup name="edCycle2Pool">
            <entity name="edZombieHusk" prob="1.0" />
            <entity name="edZombieBloater" prob="0.45" />
        </entitygroup>

        <!-- CYCLE 3 - open ground stops being safe. -->
        <entitygroup name="edCycle3Pool">
            <entity name="edZombieHusk" prob="1.0" />
            <entity name="edZombieBloater" prob="0.5" />
            <entity name="edZombieCarrionHound" prob="0.6" />
        </entitygroup>

        <!-- CYCLE 4 - the ammo economy breaks. -->
        <entitygroup name="edCycle4Pool">
            <entity name="edZombieHusk" prob="1.0" />
            <entity name="edZombieBloater" prob="0.5" />
            <entity name="edZombieCarrionHound" prob="0.6" />
            <entity name="edZombieRotweaver" prob="0.35" />
        </entitygroup>

        <!-- CYCLE 5 - night ends as an option. -->
        <entitygroup name="edCycle5Pool">
            <entity name="edZombieHusk" prob="1.0" />
            <entity name="edZombieBloater" prob="0.5" />
            <entity name="edZombieCarrionHound" prob="0.6" />
            <entity name="edZombieRotweaver" prob="0.45" />
            <entity name="edZombieHollow" prob="0.25" />
        </entitygroup>

        <!-- CYCLE 6+ - hordes gain a shape. -->
        <entitygroup name="edCycle6Pool">
            <entity name="edZombieHusk" prob="1.0" />
            <entity name="edZombieBloater" prob="0.5" />
            <entity name="edZombieCarrionHound" prob="0.6" />
            <entity name="edZombieRotweaver" prob="0.55" />
            <entity name="edZombieHollow" prob="0.35" />
            <entity name="edZombieChoir" prob="0.2" />
        </entitygroup>

        <!-- CYCLE 7+ - fortification stops being an answer. -->
        <entitygroup name="edCycle7Pool">
            <entity name="edZombieHusk" prob="1.0" />
            <entity name="edZombieBloater" prob="0.5" />
            <entity name="edZombieCarrionHound" prob="0.6" />
            <entity name="edZombieRotweaver" prob="0.6" />
            <entity name="edZombieHollow" prob="0.4" />
            <entity name="edZombieChoir" prob="0.25" />
            <!-- Rare on purpose. A Grinder should be an event, not a spawn. -->
            <entity name="edZombieGrinder" prob="0.08" />
        </entitygroup>

        <!-- Night-only pool. The Hollow is a curfew, not a horde enemy - it belongs
             in ambient night spawning rather than in blood moon waves. -->
        <entitygroup name="edNightPool">
            <entity name="edZombieHollow" prob="1.0" />
        </entitygroup>

    </append>


    <!-- ==========================================================================
         THE BIOME POOLS - hostility as geography

         WHAT THESE REPLACED, AND WHY
         ============================
         This used to be three entries appended straight into vanilla's ZombiesAll:
         Husks, Bloaters and Carrion Hounds, everywhere, from the first minute of a
         new save. Two things were wrong with that.

         It contradicted Cycle 0, which the design describes as "vanilla-adjacent,
         deliberately - you are learning the map". A player who meets a Husk in the
         pine forest on day one has not been eased into anything, and "day 8 is
         ours" stops meaning much when the eighth day brings something they have
         been killing all week.

         It also broke the announcement layer the moment that layer became real.
         The Turning fires on first contact, so a blanket ambient pool hands the
         player the Cycle 1, 2 and 3 journal entries before day two - three
         one-way, once-ever moments spent on nothing.

         GEOGRAPHY INSTEAD
         =================
         Ambient spawning has no gamestage gate; that lives only in gamestages.xml.
         So the ambient world cannot escalate on a clock, and pretending otherwise
         is how it ended up escalating on no clock at all.

         What it CAN do is vary by place. Each harsh biome now teaches exactly one
         archetype before the horde ever does, and the archetype fits the ground:

           burnt forest   Bloaters       things that rupture, where it burned
           desert         Carrion Hounds open ground is where you get run down
           snow           Rotweavers     armoured, slow, patient
           wasteland      most of them   it is the wasteland

         The starter biomes stay clean, and that is the point. The safe biome stays
         safe; what changes over time is what WALKS THROUGH it, because wandering
         hordes are gamestage-gated and go anywhere. Dread that arrives and then
         leaves again is a better mechanic than a forest that quietly gets worse.

         So the difficulty selector is the map. You can go and find Cycle 4 on day
         four, and the biome told you before you went.

         VERIFY-19 covers the biome names these attach to in spawning.xml. The
         Grinder is deliberately in none of them: it is an event, not a population.
         ========================================================================== -->

    <append xpath="/entitygroups">

        <entitygroup name="edBiomeBurntPool">
            <entity name="edZombieHusk" prob="0.35" />
            <entity name="edZombieBloater" prob="0.25" />
        </entitygroup>

        <entitygroup name="edBiomeDesertPool">
            <entity name="edZombieHusk" prob="0.3" />
            <entity name="edZombieCarrionHound" prob="0.3" />
        </entitygroup>

        <entitygroup name="edBiomeSnowPool">
            <entity name="edZombieHusk" prob="0.3" />
            <entity name="edZombieRotweaver" prob="0.2" />
        </entitygroup>

        <!-- The wasteland is the only place a Choir appears outside a horde, and it
             is rare even there. A pack with a Choir in it is a different fight, and
             meeting that once in the wasteland is a lesson worth having early. -->
        <entitygroup name="edBiomeWastePool">
            <entity name="edZombieHusk" prob="0.4" />
            <entity name="edZombieBloater" prob="0.3" />
            <entity name="edZombieRotweaver" prob="0.3" />
            <entity name="edZombieChoir" prob="0.08" />
        </entitygroup>

    </append>

</configs>
