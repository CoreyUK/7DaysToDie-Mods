<?xml version="1.0" encoding="UTF-8"?>
<!--
    THE EIGHTH DAY - items.xml
    ==========================
    New resources, research documents and Calling Writs.

    Naming convention: every identifier added by this mod is prefixed "ed".
    Every non-obvious patch carries an EIGHTHDAY comment so it can be grepped in logs.

    ART NOTE: v0.1 ships no custom art. Every item borrows a vanilla icon via CustomIcon
    and separates itself visually with CustomIconTint. Icon names are VERIFY-5 in
    docs/VERIFICATION.md - a wrong name is a missing-icon square, not a load failure.
-->
<configs>

    <!-- ==========================================================================
         THE LONG CRAFT - production intermediates

         These are the chokepoints the mid-game economy runs through. Each is cheap
         to make and awkward to source, which is what keeps players outside.
         ========================================================================== -->

    <append xpath="/items">

        <!-- Bloomery output. The first metal tier, deliberately worse than vanilla
             forged iron so that building the real forge chain still matters. -->
        <item name="edResourceCrudeIron">
            <property name="Extends" value="resourceForgedIron" />
            <property name="CustomIcon" value="resourceForgedIron" />
            <property name="CustomIconTint" value="6b5a4a" />
            <property name="DescriptionKey" value="edResourceCrudeIronDesc" />
            <property name="EconomicValue" value="14" />
            <property name="Stacknumber" value="500" />
        </item>

        <!-- Smelting agent. Burned off in the blast furnace; the reason limestone
             and bone have a reason to exist past day 10. -->
        <item name="edResourceFlux">
            <property name="Extends" value="resourceCoal" />
            <property name="CustomIcon" value="resourceCoal" />
            <property name="CustomIconTint" value="d8d0b8" />
            <property name="DescriptionKey" value="edResourceFluxDesc" />
            <property name="EconomicValue" value="8" />
            <property name="Stacknumber" value="500" />
