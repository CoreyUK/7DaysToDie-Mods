    <!-- ==========================================================================
         ATTRITION - tiered infection cures

         Vanilla honey/antibiotics handle stage 1-2 only. Stage 3+ needs an
         Apothecary. See buffs.xml for the infection staging itself.
         ========================================================================== -->

    <append xpath="/items">

        <!-- Stage 1-2. Craftable by anyone with a reagent bench. -->
        <item name="edMedTincture">
            <property name="Extends" value="drugAntibiotics" />
            <property name="CustomIcon" value="drugAntibiotics" />
            <property name="CustomIconTint" value="d8c070" />
            <property name="DescriptionKey" value="edMedTinctureDesc" />
            <property name="EconomicValue" value="240" />
            <property name="Stacknumber" value="10" />
                    <!-- Stage 1-2 only. Past that you are holding expensive brown water.
                 Sets edInfCured so the stage this removes cannot advance on the
                 way out - see the cure guard note in buffs.xml. -->
            <effect_group name="edMedTinctureCure">
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar"
                                  cvar="edInfCured" operation="set" value="1" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="edBuffInfection1" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="edBuffInfection2" />
            </effect_group>
        </item>

        <!-- Stage 3. Apothecary "Antisepsis" perk required to craft. -->
        <item name="edMedAntibiotic">
            <property name="Extends" value="drugAntibiotics" />
            <property name="CustomIcon" value="drugAntibiotics" />
            <property name="CustomIconTint" value="70b0d8" />
            <property name="DescriptionKey" value="edMedAntibioticDesc" />
            <property name="EconomicValue" value="900" />
            <property name="Stacknumber" value="10" />
                    <!-- Reverses stage 3. Apothecary, Antisepsis 4.
                 Sets edInfCured so the stage this removes cannot advance on the
                 way out - see the cure guard note in buffs.xml. -->
            <effect_group name="edMedAntibioticCure">
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar"
                                  cvar="edInfCured" operation="set" value="1" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="edBuffInfection1" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="edBuffInfection2" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="edBuffInfection3" />
            </effect_group>
        </item>

        <!-- Stage 4. Apothecary capstone only. The reason the Calling exists. -->
        <item name="edMedSerum">
            <property name="Extends" value="drugAntibiotics" />
            <property name="CustomIcon" value="drugAntibiotics" />
            <property name="CustomIconTint" value="c070d8" />
            <property name="DescriptionKey" value="edMedSerumDesc" />
            <property name="EconomicValue" value="2600" />
            <property name="Stacknumber" value="5" />
                    <!-- The only thing that touches stage 4. Apothecary capstone.
                 Sets edInfCured so the stage this removes cannot advance on the
                 way out - see the cure guard note in buffs.xml. -->
            <effect_group name="edMedSerumCure">
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar"
                                  cvar="edInfCured" operation="set" value="1" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="edBuffInfection1" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="edBuffInfection2" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="edBuffInfection3" />
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="edBuffInfection4" />
            </effect_group>
        </item>

    </append>


    <!-- ==========================================================================
         GEAR - what the Calling trees actually pay out

         Every item below is the payload of a RecipeUnlock tag in progression.xml.
         A perk that unlocks nothing is a perk nobody spends a point on, so this
         section exists to make the trees worth climbing.

         WEAPON ART NOTE: these are mechanically new weapons that reuse vanilla
         meshes and animations. That is a v0.2 constraint, not a design position -
         see docs/ART.md for the icon and model pipeline and what it would take to
         give them their own art.

         VERIFY-11 (docs/VERIFICATION.md): every Extends base in this section is a
         vanilla weapon, tool, armour or explosive name that must be confirmed
         against V3.2. These change between versions more often than resources do.
         ========================================================================== -->


