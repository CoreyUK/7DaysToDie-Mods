    <!-- ==========================================================================
         CALLINGS - Writs

         A Writ is the reward for completing a Calling's Proving chain (see
         quests.xml). Consuming it sets edMark<Calling> = 1 permanently, which
         opens that Calling's perk branch - every perk in the branch requires it
         (see progression.xml).

         As of 0.2 these are NOT sold, NOT in loot and NOT craftable. Finishing
         a Proving is the only way to get one, and that is the whole point: a
         Calling you can buy is a purchase, not a discipline. Do not add another
         source without deciding to change that pillar deliberately.
         ========================================================================== -->

    <append xpath="/items">

        <item name="edWritIronmonger">
            <property name="Extends" value="casinoCoin" />
            <property name="CustomIcon" value="resourcePaper" />
            <property name="CustomIconTint" value="c07040" />
            <property name="DescriptionKey" value="edWritIronmongerDesc" />
            <property name="EconomicValue" value="3500" />
            <property name="Stacknumber" value="1" />
            <property name="Group" value="Books" />
            <property class="Action1">
                <property name="Class" value="Eat" />
                <property name="Delay" value="1.5" />
                <property name="Use_time" value="2.0" />
            </property>
            <effect_group name="edWritIronmongerGrant">
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar"
                                  cvar="edMarkIronmonger" operation="set" value="1" />
            </effect_group>
        </item>

        <item name="edWritTrapper">
            <property name="Extends" value="edWritIronmonger" />
            <property name="CustomIconTint" value="6f9a5a" />
            <property name="DescriptionKey" value="edWritTrapperDesc" />
