<?xml version="1.0" encoding="UTF-8"?>
<!--
    THE EIGHTH DAY - progression.xml
    ================================
    The six Callings, plus the stretched progression curve.

    HOW THE GATE WORKS
    ==================
    Every perk in a Calling branch carries a CVarCompare requirement on that Calling's
    Mark (edMarkIronmonger, edMarkTrapper, ...). The branch is therefore VISIBLE but
    UNSPENDABLE until the Mark is earned. That keeps the whole Calling system inside
    vanilla progression plumbing - no custom UI, no assembly.

    Marks are set by completing a Proving quest chain (0.2). In 0.1 they are set by
    consuming a Writ item - see items.xml.

    VERIFY-6 (docs/VERIFICATION.md): confirm the CVarCompare requirement element and
    every passive_effect name below against V3.2's Data/Config/progression.xml.

    BALANCE INTENT
    ==============
    Perk points are scarce by design. Filling two branches is a full playthrough's
    worth of points; filling all six is not intended to be reachable. Every capstone
    benefits people OTHER than the holder, which makes the last point in a branch a
    social decision rather than a stat bump.
-->
<configs>

    <!-- ==========================================================================
         THE STRETCHED CURVE

         Vanilla's curve tops out and then flattens. Raising the cap and flattening
         the XP rate means you are never "done" perking, so you are always choosing.
         ========================================================================== -->

    <set xpath="/progression/@max_level">300</set>
    <set xpath="/progression/@exp_to_level">12000</set>
    <set xpath="/progression/@experience_multiplier">1.075</set>


    <!-- ==========================================================================
         IRONMONGER - attStrength
         "The one who makes the things that make things."

         Owns the metal chain end to end. Nobody else can produce hardened steel or
         carbide, which makes the Ironmonger the bottleneck on every other Calling's
         late-game gear. Deliberately powerful, deliberately dependent.
         ========================================================================== -->

    <append xpath="/progression/perks">

        <perk name="edPerkBloomBillet" parent="attStrength" max_level="5" base_skill_point_cost="1"
              name_key="edPerkBloomBilletName" desc_key="edPerkBloomBilletDesc"
              icon="ui_game_symbol_forge">
            <requirement name="CVarCompare" cvar="edMarkIronmonger" operation="Equals" value="1" />
            <effect_group>
                <passive_effect name="CraftingTime" operation="perc_add" level="1,5"
                                value="-0.1,-0.4" tags="edSmelting" />
                <passive_effect name="HarvestCount" operation="perc_add" level="1,5"
                                value="0.15,0.6" tags="oreHarvest" />
            </effect_group>
        </perk>

        <perk name="edPerkAlloying" parent="attStrength" max_level="5" base_skill_point_cost="1"
              name_key="edPerkAlloyingName" desc_key="edPerkAlloyingDesc"
              icon="ui_game_symbol_forge">
            <requirement name="CVarCompare" cvar="edMarkIronmonger" operation="Equals" value="1" />
            <effect_group>
                <passive_effect name="RecipeUnlock" operation="base_set" level="2" value="1"
                                tags="edRecipeHardenedSteel" />
                <passive_effect name="RecipeUnlock" operation="base_set" level="4" value="1"
                                tags="edRecipeCarbide" />
            </effect_group>
        </perk>

        <perk name="edPerkTempering" parent="attStrength" max_level="4" base_skill_point_cost="1"
              name_key="edPerkTemperingName" desc_key="edPerkTemperingDesc"
              icon="ui_game_symbol_smithing">
            <requirement name="CVarCompare" cvar="edMarkIronmonger" operation="Equals" value="1" />
            <effect_group>
                <passive_effect name="CraftingQualityBonus" operation="base_add" level="1,4"
                                value="1,4" tags="edMetalwork" />
            </effect_group>
        </perk>

        <perk name="edPerkCasings" parent="attStrength" max_level="4" base_skill_point_cost="1"
              name_key="edPerkCasingsName" desc_key="edPerkCasingsDesc"
              icon="ui_game_symbol_bullets">
            <requirement name="CVarCompare" cvar="edMarkIronmonger" operation="Equals" value="1" />
