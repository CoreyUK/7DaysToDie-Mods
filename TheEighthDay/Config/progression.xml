                                value="0.2,0.9" tags="edAmmoCrafting" />
            </effect_group>
        </perk>

        <perk name="edPerkMasterForge" parent="attStrength" max_level="1" base_skill_point_cost="5"
              name_key="edPerkMasterForgeName" desc_key="edPerkMasterForgeDesc"
              icon="ui_game_symbol_forge">
            <requirement name="CVarCompare" cvar="edMarkIronmonger" operation="Equals" value="1" />
