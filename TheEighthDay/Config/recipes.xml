                tags="edResearch">
            <ingredient name="edNoteChemistry" count="5" />
            <ingredient name="resourcePaper" count="20" />
        </recipe>

    </append>


    <!-- ==========================================================================
         THE LONG CRAFT, APPLIED TO VANILLA

         Reroute vanilla's two-step chain through the new intermediates so the
         production tier actually gates the gear tier. Without this the mod adds
         workstations nobody needs.

         EIGHTHDAY: steel now demands crude iron and flux rather than falling out
         of a forge, which is what puts the Ironmonger on the critical path.
         ========================================================================== -->

    <set xpath="/recipes/recipe[@name='resourceForgedSteel']/@craft_area">edBlastFurnace</set>

    <append xpath="/recipes/recipe[@name='resourceForgedSteel']">
        <ingredient name="edResourceFlux" count="1" />
    </append>


