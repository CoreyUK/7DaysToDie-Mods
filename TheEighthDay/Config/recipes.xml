                tags="edChemistry,edMedical,edRecipeAntibiotic" unlocked_by_recipe="false">
            <ingredient name="edResourceReagentBase" count="5" />
            <ingredient name="drugAntibiotics" count="2" />
            <ingredient name="edResourcePolymer" count="1" />
        </recipe>

        <!-- Stage 4 cure. Apothecary capstone only. The reason the Calling exists. -->
        <recipe name="edMedSerum" count="1" craft_area="edReagentBench" craft_time="180"
                tags="edChemistry,edMedical,edRecipeSerum" unlocked_by_recipe="false">
            <ingredient name="edMedAntibiotic" count="2" />
            <ingredient name="edResourceReagentBase" count="10" />
            <ingredient name="edResourcePrecisionParts" count="1" />
        </recipe>


        <!-- ==================================================================
             THE DRAFTING TABLE - research

             Field Notes are partial and damaged. Several of the same discipline
             reconstruct into one usable recipe. The counts are deliberately
             uncomfortable: research should be an expedition, not an errand.

             VERIFY-10: these drop rates and counts are guesses. Too few and the
             tech tree trivialises; too many and the research loop stalls.
             ================================================================== -->

        <recipe name="edResourcePrecisionParts" count="4" craft_area="edDrafting"
                craft_time="60" tags="edResearch">
            <ingredient name="edNoteMetallurgy" count="5" />
            <ingredient name="resourcePaper" count="20" />
        </recipe>

