            <ingredient name="edResourcePolymer" count="4" />
        </recipe>


        <!-- ==================================================================
             TIER 1.5 - REAGENT BENCH
             The Apothecary's chain. Tiered cures for tiered infection.
             ================================================================== -->

        <recipe name="edResourceReagentBase" count="2" craft_area="edReagentBench"
                craft_time="30" tags="edChemistry">
            <ingredient name="resourceAcid" count="1" />
            <ingredient name="resourceNitratePowder" count="4" />
            <ingredient name="resourceWaterBottle" count="1" />
        </recipe>

