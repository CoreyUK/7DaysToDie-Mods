            <ingredient name="edResourceFlux" count="6" />
            <ingredient name="resourceCoal" count="20" />
        </recipe>


        <!-- ==================================================================
             TIER 2 - MACHINE SHOP
             The chokepoint every powered thing runs through.
             ================================================================== -->

