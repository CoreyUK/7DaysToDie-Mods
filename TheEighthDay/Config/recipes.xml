        <recipe name="edMedTincture" count="1" craft_area="edReagentBench" craft_time="45"
                tags="edChemistry,edMedical,edRecipeTincture" unlocked_by_recipe="false">
            <ingredient name="edResourceReagentBase" count="2" />
            <ingredient name="resourceHerbalAntibiotics" count="1" />
        </recipe>

        <!-- Stage 3 cure. Apothecary, Antisepsis 4. -->
