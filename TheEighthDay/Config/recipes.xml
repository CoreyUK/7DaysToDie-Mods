<?xml version="1.0" encoding="UTF-8"?>
<!--
    THE EIGHTH DAY - recipes.xml
    ============================
    The Long Craft, expressed as recipes.

    Two rules govern this whole file:

      1. INTERMEDIATES BOTTLENECK. Flux, precision parts and polymer are cheap to make
         and awkward to source. That keeps mid-game players going outside rather than
         sitting in a base perking up.

      2. RESEARCH BEATS LOOTBOXES. The highest tier of every discipline is reconstructed
         at the Drafting Table from Field Notes. It cannot be bought, perked, or looted
         directly - you have to go to the places the notes are.

    The "tags" on each recipe are what progression.xml's RecipeUnlock effects key off.
-->
<configs>

    <append xpath="/recipes">

        <!-- ==================================================================
             WORKSTATIONS
             ================================================================== -->

        <recipe name="edBlockBloomery" count="1" craft_area="workbench" craft_time="30">
            <ingredient name="resourceStone" count="120" />
            <ingredient name="resourceClayLump" count="80" />
            <ingredient name="resourceWood" count="40" />
        </recipe>

        <recipe name="edBlockBlastFurnace" count="1" craft_area="workbench" craft_time="180"
                tags="edStructural">
            <ingredient name="resourceForgedIron" count="250" />
            <ingredient name="resourceCement" count="200" />
            <ingredient name="edResourceFlux" count="60" />
            <ingredient name="resourceMechanicalParts" count="30" />
        </recipe>

        <recipe name="edBlockMachineShop" count="1" craft_area="workbench" craft_time="180">
            <ingredient name="resourceForgedSteel" count="150" />
            <ingredient name="resourceMechanicalParts" count="60" />
            <ingredient name="resourceElectricParts" count="30" />
        </recipe>

        <recipe name="edBlockReagentBench" count="1" craft_area="workbench" craft_time="120">
            <ingredient name="resourceForgedIron" count="80" />
            <ingredient name="resourceGlue" count="40" />
            <ingredient name="resourceElectricParts" count="15" />
        </recipe>

        <recipe name="edBlockDraftingTable" count="1" craft_area="workbench" craft_time="90">
            <ingredient name="resourceWood" count="150" />
            <ingredient name="resourcePaper" count="100" />
            <ingredient name="resourceForgedIron" count="25" />
        </recipe>


        <!-- ==================================================================
             TIER 0.5 - BLOOMERY
             Day-2 metal. Bad metal, but yours.
             ================================================================== -->

        <recipe name="edResourceCrudeIron" count="1" craft_area="edBloomery" craft_time="12"
                tags="edSmelting">
            <ingredient name="resourceIronFragment" count="8" />
            <ingredient name="resourceCoal" count="2" />
        </recipe>

        <!-- Flux. Limestone and bone finally have a job. -->
        <recipe name="edResourceFlux" count="4" craft_area="edBloomery" craft_time="8"
                tags="edSmelting">
            <ingredient name="resourceCrushedSand" count="6" />
            <ingredient name="resourceBone" count="4" />
        </recipe>


        <!-- ==================================================================
             TIER 2 - BLAST FURNACE
             Ironmonger territory. Hardened steel and carbide are perk-gated:
             see progression.xml, edPerkAlloying.
             ================================================================== -->

        <recipe name="edResourceHardenedSteel" count="1" craft_area="edBlastFurnace"
                craft_time="45" tags="edSmelting,edRecipeHardenedSteel" unlocked_by_recipe="false">
            <ingredient name="resourceForgedSteel" count="4" />
            <ingredient name="edResourceFlux" count="2" />
            <ingredient name="resourceCoal" count="6" />
        </recipe>

        <recipe name="edResourceCarbide" count="1" craft_area="edBlastFurnace"
                craft_time="120" tags="edSmelting,edRecipeCarbide" unlocked_by_recipe="false">
